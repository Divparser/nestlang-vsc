{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    ["(", ")"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" }
  ],
  "surroundingPairs": [
    ["(", ")"]
  ],
  "indentationRules": {
    "increaseIndentPattern": "^.*\\(array:object\\)\\s*$|^.*\\(object\\)\\s*$",
    "decreaseIndentPattern": "^\\s*$"
  }
}
